# =============================================================================
# 🏫 SCHOOLWAY CENTRALIZED CONFIGURATION & SECRETS TEMPLATE
# =============================================================================
# This file is the single source of truth for all secrets across the repository.
#
# Instructions:
#   1. Copy this template to .env in the project root:
#        cp .env.example .env
#   2. Fill in your API keys and credentials below.
#   3. Sync secrets to native platforms and cloud functions automatically:
#        dart run tool/sync_secrets.dart
#
# NOTE: .env is ignored by Git and will NEVER be committed to the repository.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Google Maps Platform Keys
# -----------------------------------------------------------------------------
# Google Cloud Console: https://console.cloud.google.com/google/maps-apis
# - Android Maps Key: Restrict to Android apps (package: com.schoolway.app)
MAPS_API_KEY=AIzaSyYourAndroidMapsApiKeyHere
GOOGLE_MAPS_API_KEY=AIzaSyYourAndroidMapsApiKeyHere

# - Web Maps Key: Restrict to HTTP referrers (e.g. https://schoolway-0428.web.app)
GOOGLE_MAPS_WEB_API_KEY=AIzaSyYourWebMapsApiKeyHere

# - Server-Side Routes API Key: Restrict to Google Routes API (used by Cloud Functions)
GOOGLE_ROUTES_API_KEY=AIzaSyYourGoogleRoutesApiKeyHere

# -----------------------------------------------------------------------------
# 2. Firebase Cloud Messaging (Web Push)
# -----------------------------------------------------------------------------
# Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates
FCM_WEB_VAPID_KEY=YOUR_PUBLIC_FCM_VAPID_KEY_HERE

# -----------------------------------------------------------------------------
# 3. Firebase Project Identity (Client SDK)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=schoolway-0428
FIREBASE_API_KEY=AIzaSyYourFirebaseWebApiKeyHere
FIREBASE_APP_ID_ANDROID=1:137687591166:android:b2089bcf279bca1b585ef4
FIREBASE_APP_ID_IOS=1:137687591166:ios:b5e7d4ad22a1ce09585ef4
FIREBASE_APP_ID_WEB=1:137687591166:web:65baea7b4da17e08585ef4
FIREBASE_MESSAGING_SENDER_ID=137687591166
FIREBASE_STORAGE_BUCKET=schoolway-0428.firebasestorage.app

# -----------------------------------------------------------------------------
# 4. Cloudflare Deployment (Edge Hosting)
# -----------------------------------------------------------------------------
# Cloudflare Dashboard -> Workers & Pages -> Overview
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
