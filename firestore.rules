rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function role() {
      return isSignedIn() ? currentUser().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'administrator';
    }

    function isDriver() {
      return role() == 'driver';
    }

    function isParent() {
      return role() == 'parent';
    }

    function bus(busId) {
      return get(/databases/$(database)/documents/buses/$(busId));
    }

    function isAssignedDriver(busId) {
      return isDriver() &&
        bus(busId).data.currentDriverUid == request.auth.uid;
    }

    function isBusParent(busId) {
      return isParent() &&
        exists(/databases/$(database)/documents/bus_access/$(busId)/members/$(request.auth.uid));
    }

    function canAccessBus(busId) {
      return isAdmin() || isAssignedDriver(busId) || isBusParent(busId);
    }

    function student(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId));
    }

    function canAccessStudent(studentId) {
      let data = student(studentId).data;
      return isAdmin() ||
        (isParent() && request.auth.uid in data.parentAuthUids) ||
        (isDriver() && isAssignedDriver(data.assignedBusId));
    }

    match /users/{authUid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == authUid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == authUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'email',
          'emailVerified',
          'phoneNumber',
          'countryCode',
          'gender',
          'birthday',
          'lastLoginAt',
          'updatedAt'
        ]) &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isActive == resource.data.isActive
      );

      match /devices/{deviceId} {
        allow read, create, update, delete: if isSignedIn() &&
          request.auth.uid == authUid;
      }

      match /notification_prefs/{documentId} {
        allow read, write: if isSignedIn() &&
          (request.auth.uid == authUid || isAdmin());
      }
    }

    match /user_directory/{authUid} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /bus_access/{busId}/members/{authUid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == authUid || isAdmin());
      allow write: if false;
    }

    match /buses/{busId} {
      // Use the queried document for driver authorization so Firestore can
      // prove a `currentDriverUid == request.auth.uid` collection query.
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isDriver() && resource.data.currentDriverUid == request.auth.uid) ||
        (isParent() && exists(/databases/$(database)/documents/bus_access/$(busId)/members/$(request.auth.uid)))
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAssignedDriver(busId) &&
        request.resource.data.currentDriverUid == resource.data.currentDriverUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'currentSessionId',
          'lastLocation',
          'updatedAt'
        ])
      );
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isParent() && request.auth.uid in resource.data.parentAuthUids) ||
        (isDriver() && isAssignedDriver(resource.data.assignedBusId))
      );
      allow write: if isAdmin();
    }

    match /boarding_events/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isDriver() && resource.data.driverUid == request.auth.uid) ||
        (isParent() && canAccessStudent(resource.data.studentId))
      );
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.driverUid == request.auth.uid &&
        isAssignedDriver(request.resource.data.busId) &&
        canAccessStudent(request.resource.data.studentId);
      allow update, delete: if isAdmin();
    }

    match /route_sessions/{sessionId} {
      allow read: if isSignedIn() && canAccessBus(resource.data.busId);
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.driverUid == request.auth.uid &&
        isAssignedDriver(request.resource.data.busId);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.driverUid == request.auth.uid &&
        request.resource.data.driverUid == resource.data.driverUid &&
        request.resource.data.busId == resource.data.busId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'endTime',
          'gpsTrackingEnabled',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();

      match /breadcrumbs/{breadcrumbId} {
        allow read: if isSignedIn() &&
          canAccessBus(get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.busId);
        allow create: if isSignedIn() &&
          isDriver() &&
          get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.driverUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      match /geofence_events/{eventId} {
        allow read: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.driverUid == request.auth.uid
        );
        allow create: if isSignedIn() &&
          isDriver() &&
          request.resource.data.driverUid == request.auth.uid &&
          request.resource.data.busId == get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.busId &&
          get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.driverUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /gps_tracking/{busId} {
      allow read: if isSignedIn() && canAccessBus(busId);
      allow create, update: if isSignedIn() &&
        isAssignedDriver(busId) &&
        request.resource.data.driverUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /emergency_alerts/{alertId} {
      allow read: if isAdmin() ||
        (isSignedIn() && isDriver() && resource.data.driverUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.driverUid == request.auth.uid &&
        isAssignedDriver(request.resource.data.busId);
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create, delete: if false;
      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /planned_routes/{routeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /attendance_corrections/{correctionId} {
      allow read: if isAdmin() ||
        (isSignedIn() && isDriver() && resource.data.correctedByUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.correctedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow read: if isAdmin() ||
        (isSignedIn() && isDriver() && resource.data.driverUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.driverUid == request.auth.uid &&
        isAssignedDriver(request.resource.data.busId);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.driverUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description',
          'severity',
          'resolved',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /app_config/{documentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /school_config/{documentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
