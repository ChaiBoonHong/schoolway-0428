rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveUser() {
      return isSignedIn() && currentUser().data.isActive == true;
    }

    function role() {
      return isActiveUser() ? currentUser().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'administrator';
    }

    function isDriver() {
      return role() == 'driver';
    }

    function isParent() {
      return role() == 'parent';
    }

    function bus(busId) {
      return get(/databases/$(database)/documents/buses/$(busId));
    }

    function isAssignedDriver(busId) {
      return isDriver() &&
        bus(busId).data.currentDriverUid == request.auth.uid;
    }

    function isBusParent(busId) {
      return isParent() &&
        exists(/databases/$(database)/documents/bus_access/$(busId)) &&
        get(/databases/$(database)/documents/bus_access/$(busId)).data.members is list &&
        request.auth.uid in get(/databases/$(database)/documents/bus_access/$(busId)).data.members;
    }

    function canAccessBus(busId) {
      return isAdmin() || isAssignedDriver(busId) || isBusParent(busId);
    }

    function student(studentId) {
      return get(/databases/$(database)/documents/students/$(studentId));
    }

    function routeSession(sessionId) {
      return get(/databases/$(database)/documents/route_sessions/$(sessionId));
    }

    function isValidGpsPayload(busId, sessionId) {
      let data = request.resource.data;
      let session = routeSession(sessionId).data;
      return data.keys().hasAll([
          'latitude',
          'longitude',
          'speed',
          'heading',
          'accuracy',
          'timestamp',
          'sessionId',
          'driverUid',
          'isSimulated'
        ]) &&
        data.keys().hasOnly([
          'latitude',
          'longitude',
          'speed',
          'heading',
          'accuracy',
          'timestamp',
          'sessionId',
          'driverUid',
          'isSimulated'
        ]) &&
        sessionId is string &&
        data.sessionId == sessionId &&
        data.driverUid == request.auth.uid &&
        session.driverUid == request.auth.uid &&
        session.busId == busId &&
        session.status == 'Active' &&
        data.latitude is number &&
        data.latitude >= -90 &&
        data.latitude <= 90 &&
        data.longitude is number &&
        data.longitude >= -180 &&
        data.longitude <= 180 &&
        data.speed is number &&
        data.speed >= 0 &&
        data.speed <= 400 &&
        data.heading is number &&
        data.heading >= 0 &&
        data.heading <= 360 &&
        data.accuracy is number &&
        data.accuracy >= 0 &&
        data.timestamp is timestamp &&
        data.isSimulated == false;
    }

    function canAccessStudent(studentId) {
      let data = student(studentId).data;
      return isAdmin() ||
        (isParent() && request.auth.uid in data.parentAuthUids) ||
        (isDriver() && isAssignedDriver(data.assignedBusId));
    }

    match /users/{authUid} {
      allow read: if isSignedIn() &&
        (request.auth.uid == authUid || isAdmin());
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.auth.uid == authUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'firstName',
          'lastName',
          'email',
          'emailVerified',
          'phoneNumber',
          'countryCode',
          'gender',
          'birthday',
          'lastLoginAt',
          'updatedAt'
        ]) &&
        request.resource.data.authUid == request.auth.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.isActive == resource.data.isActive
      );

      match /devices/{deviceId} {
        allow read, create, update, delete: if isActiveUser() &&
          request.auth.uid == authUid;
      }

      match /notification_prefs/{documentId} {
        allow read, write: if isActiveUser() &&
          (request.auth.uid == authUid || isAdmin());
      }
    }

    match /user_directory/{authUid} {
      allow read: if isActiveUser();
      allow write: if false;
    }

    match /bus_access/{busId} {
      // Membership lists contain other users' Auth UIDs. Clients do not need
      // to read them; rules use the list internally for bus authorization.
      allow read: if isAdmin();
      allow write: if false;
    }

    match /buses/{busId} {
      // Use the queried document for driver authorization so Firestore can
      // prove a `currentDriverUid == request.auth.uid` collection query.
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isDriver() && resource.data.currentDriverUid == request.auth.uid) ||
        isBusParent(busId)
      );
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAssignedDriver(busId) &&
        request.resource.data.currentDriverUid == resource.data.currentDriverUid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastLocation',
          'updatedAt'
        ]) &&
        (!request.resource.data.keys().hasAny(['lastLocation']) ||
          request.resource.data.lastLocation.isSimulated == false)
      );
    }

    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isParent() && request.auth.uid in resource.data.parentAuthUids) ||
        (isDriver() && isAssignedDriver(resource.data.assignedBusId))
      );
      allow write: if isAdmin();
    }

    match /boarding_events/{eventId} {
      allow read: if isSignedIn() && (
        isAdmin() ||
        (isDriver() && resource.data.driverUid == request.auth.uid) ||
        (isParent() && canAccessStudent(resource.data.studentId))
      );
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    match /route_sessions/{sessionId} {
      allow read: if isSignedIn() && canAccessBus(resource.data.busId);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin();

      match /attendance_state/{studentId} {
        allow read: if isSignedIn() &&
          canAccessBus(get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.busId);
        allow write: if false;
      }

      match /breadcrumbs/{breadcrumbId} {
        allow read: if isSignedIn() &&
          canAccessBus(get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.busId);
        allow create: if isSignedIn() &&
          isDriver() &&
          isValidGpsPayload(
            get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.busId,
            sessionId
          );
        allow update, delete: if isAdmin();
      }

      match /geofence_events/{eventId} {
        allow read: if isAdmin() || (
          isSignedIn() &&
          get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.driverUid == request.auth.uid
        );
        allow create: if isSignedIn() &&
          isDriver() &&
          request.resource.data.driverUid == request.auth.uid &&
          request.resource.data.busId == get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.busId &&
          get(/databases/$(database)/documents/route_sessions/$(sessionId)).data.driverUid == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /gps_tracking/{busId} {
      allow read: if isSignedIn() && canAccessBus(busId);
      allow create, update: if isSignedIn() &&
        isAssignedDriver(busId) &&
        isValidGpsPayload(busId, request.resource.data.sessionId);
      allow delete: if isAdmin();
    }

    match /emergency_alerts/{alertId} {
      allow read: if isAdmin() ||
        (isSignedIn() && isDriver() && resource.data.driverUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.driverUid == request.auth.uid &&
        isAssignedDriver(request.resource.data.busId);
      allow update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() &&
        (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow create: if false;
      allow delete: if isSignedIn() &&
        (resource.data.recipientUid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() &&
        resource.data.recipientUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }

    match /route_deviation_alerts/{alertId} {
      allow read: if isAdmin() || (
        isSignedIn() && isDriver() && resource.data.driverUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.keys().hasAll([
          'sessionId',
          'busId',
          'driverUid',
          'latitude',
          'longitude',
          'corridorMeters',
          'status',
          'timestamp'
        ]) &&
        request.resource.data.driverUid == request.auth.uid &&
        request.resource.data.busId == routeSession(request.resource.data.sessionId).data.busId &&
        routeSession(request.resource.data.sessionId).data.driverUid == request.auth.uid &&
        isAssignedDriver(request.resource.data.busId) &&
        request.resource.data.latitude is number &&
        request.resource.data.latitude >= -90 &&
        request.resource.data.latitude <= 90 &&
        request.resource.data.longitude is number &&
        request.resource.data.longitude >= -180 &&
        request.resource.data.longitude <= 180 &&
        request.resource.data.corridorMeters is number &&
        request.resource.data.corridorMeters >= 100 &&
        request.resource.data.corridorMeters <= 1000 &&
        request.resource.data.status == 'active';
      allow update, delete: if isAdmin();
    }

    match /planned_routes/{routeId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /attendance_corrections/{correctionId} {
      allow read: if isAdmin() ||
        (isSignedIn() && isDriver() && resource.data.correctedByUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.correctedByUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /incidents/{incidentId} {
      allow read: if isAdmin() ||
        (isSignedIn() && isDriver() && resource.data.driverUid == request.auth.uid);
      allow create: if isSignedIn() &&
        isDriver() &&
        request.resource.data.driverUid == request.auth.uid &&
        isAssignedDriver(request.resource.data.busId);
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.driverUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'description',
          'severity',
          'resolved',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    match /app_config/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /routing_cache/{sessionId} {
      allow read, write: if false;
    }

    match /school_config/{documentId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }
  }
}
