rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==================== HELPER FUNCTIONS ====================
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.role;
    }
    
    function getUsername() {
      return get(/databases/$(database)/documents/user_roles/$(request.auth.uid)).data.username;
    }
    
    function isAdmin() { 
      let role = getUserRole();
      return role == 'admin' || role == 'administrator'; 
    }
    
    function isDriver() { 
      return getUserRole() == 'driver'; 
    }
    
    function isParent() { 
      return getUserRole() == 'parent'; 
    }

    // ==================== USER ROLES COLLECTION ====================
    
    match /user_roles/{authUid} {
      // Users can read their own role mapping
      allow read: if isSignedIn() && request.auth.uid == authUid;
      // Anyone can create (needed during sign-up), admins can modify
      allow write: if isSignedIn(); 
    }
    
    // ==================== USERS COLLECTION ====================
    
    match /users/{username} {
      allow read: if isSignedIn();
      // Allow users to update their own profile, or admins to update any
      allow update: if isSignedIn() && (getUsername() == username || isAdmin());
      // Creating users is allowed if admin, or if self (sign up)
      allow create: if isSignedIn();
      allow delete: if isAdmin();
    }
    
    // ==================== BUSES COLLECTION ====================
    
    match /buses/{busId} {
      // Anyone can read
      allow read: if isSignedIn();
      // Admins can manage buses, drivers can update if assigned
      allow write: if isAdmin() || (isDriver() && resource.data.currentDriverId == getUsername());
    }
    
    // ==================== STUDENTS COLLECTION ====================
    
    match /students/{studentId} {
      // Parents can only read if their username is in parentIds
      // Drivers and Admins can read all
      allow read: if isSignedIn() && (
        isAdmin() || 
        isDriver() || 
        (isParent() && getUsername() in resource.data.parentIds)
      );
      
      // Only admins can write
      allow write: if isAdmin();
    }
    
    // ==================== BOARDING EVENTS COLLECTION ====================
    
    match /boarding_events/{eventId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDriver();
    }
    
    // ==================== ROUTE SESSIONS COLLECTION ====================
    
    match /route_sessions/{sessionId} {
      allow read: if isSignedIn();
      // Drivers can create/update sessions if they are the driver
      allow create: if isSignedIn() && (isAdmin() || (isDriver() && request.resource.data.driverId == getUsername()));
      allow update: if isSignedIn() && (isAdmin() || (isDriver() && resource.data.driverId == getUsername()));
      allow delete: if isAdmin();
      
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isAdmin() || isDriver();
      }
    }
    
    // ==================== GPS TRACKING COLLECTION ====================
    
    match /gps_tracking/{busId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDriver();
    }
    
    // ==================== EMERGENCY ALERTS COLLECTION ====================
    
    match /emergency_alerts/{alertId} {
      allow read: if isAdmin() || isDriver();
      allow create: if isDriver() || isAdmin();
      allow update, delete: if isAdmin();
    }
    
    // ==================== NOTIFICATIONS COLLECTION ====================
    
    match /notifications/{notificationId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDriver();
    }
    
    // ==================== ROUTES COLLECTION ====================
    
    match /routes/{routeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    match /planned_routes/{routeId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // ==================== ATTENDANCE CORRECTIONS & INCIDENTS ====================
    
    match /attendance_corrections/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDriver();
    }
    
    match /incidents/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isDriver();
    }
    
    // ==================== APP CONFIG ====================
    
    match /app_config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
